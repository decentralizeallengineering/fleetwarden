# Copy to ~/.config/claude-sessions/<NAME>.env, then: systemctl --user enable --now claude@<NAME>
# systemd reads this file as an EnvironmentFile: no variable expansion, so write absolute paths.
SID=00000000-0000-4000-8000-000000000001
CWD=/home/example/work/project
# Optional:
#FLAGS=--model sonnet
#SETTINGS=/home/example/.config/claude-sessions/lean.settings.json
#STRICT_MCP=1
#REMOTE_CONTROL=1
#CLAUDE_BIN=/home/example/.local/bin/claude
